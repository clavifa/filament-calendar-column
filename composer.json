{
    "name": "clavifa/filament-calendar-column",
    "description": "Calendar-style table column plugin for Filament 5.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Clavifa"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Clavifa\\FilamentCalendarColumn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clavifa\\FilamentCalendarColumn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clavifa\\FilamentCalendarColumn\\FilamentCalendarColumnServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}